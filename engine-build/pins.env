# Pinned inputs for the TeX engine build. Every one of these is a cache-key input: ENGINE_ID is the
# sha256 of the minified worker bundle, which embeds what they produce (tex.wasm, core.dump, every
# bundled TeX file), so it changes whenever one of these changes what is built.
#
# Verify a pin before bumping it. `git log --oneline <old>..<new>` in the upstream repo, then
# rebuild and diff the golden corpus. A silent engine bump invalidates every cached diagram in
# every user's vault.

# github.com/drgrice1/web2js — Pascal(TeX WEB) -> WebAssembly compiler.
# Applies changes/expanded.ch and changes/strcmp.ch, which is what gives this engine the
# \expanded and \pdfstrcmp primitives that expl3 requires. See internal/DECISIONS.md D8.
WEB2JS_REPO=https://github.com/drgrice1/web2js.git
WEB2JS_REF=0114ef5905dc387b70e72c654bcedd3b52b29fad   # 2025-01-07

# github.com/drgrice1/tikzjax — the loader, tex_files.json and the font pipeline.
TIKZJAX_REPO=https://github.com/drgrice1/tikzjax.git
TIKZJAX_REF=461ac15f1c63351392115c4262d8179bc9922404   # 2026-06-08

# Computer Modern Type1 fonts, extracted by tikzjax's installFonts.mjs.
BAKOMA_URL=https://mirrors.ctan.org/fonts/cm/ps-type1/bakoma.zip

# TeX package versions come from whatever TeX distribution kpsewhich finds inside the image
# (genTexFiles.js resolves every name in tex_files.json through it), so the distribution IS the
# package-version pin. See engine-build/Dockerfile's TEXLIVE arg.
#   apt = Ubuntu 24.04's texlive  -> TeX Live 2023  (what upstream builds against; the known-good path)
#   net = TUG net installer       -> whatever TeX Live is current on the day of the build (unpinned;
#                                    TODO.md E1 keeps a dated list of what that would bring)
TEXLIVE=apt
