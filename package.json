{
  "name": "tikzjax-next",
  "version": "0.2.1-beta.4",
  "description": "Render TikZ and LaTeX diagrams in your notes",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "//": [
    "Two TypeScripts, deliberately. See internal/DECISIONS.md D5.",
    "  typescript 5.9.3  is what lint:store runs on and what typecheck:legacy compiles with. It is a",
    "                    TypeScript 5 on purpose: the community store's review lints this code through",
    "                    TypeScript 5 (eslint-plugin-obsidianmd depends on typescript 5.4.5), and a",
    "                    typing TS 7 accepts has already come out of TS 5 as `any` once. typescript-",
    "                    eslint's peer range would allow 6.0.x; that is not what holds it here.",
    "  tsgo              is the real typechecker: an alias for typescript@7.0.2, the native Go",
    "                    compiler. Aliased so it does not collide with the above; every script names",
    "                    its compiler by path because both packages ship a `tsc` bin.",
    "When the store lints with TS 7 and typescript-eslint loads on it: delete the alias, bump",
    "typescript, drop typecheck:legacy."
  ],
  "scripts": {
    "dev": "node scripts/esbuild.config.mjs",
    "build": "npm run typecheck && node scripts/esbuild.config.mjs production",
    "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "oxlint src scripts engine-src test --ignore-pattern \"engine-src/upstream/**\"",
    "lint:store": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "verify:golden": "node scripts/verify-golden.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify:reset": "node scripts/verify-reset.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "scan:native": "node scripts/scan-native-unicode.mjs",
    "engine:image": "docker build -t tikzjax-engine:apt --build-arg TEXLIVE=apt engine-build",
    "engine:image:latest": "docker build -t tikzjax-engine:net --build-arg TEXLIVE=net engine-build",
    "engine:build": "node scripts/engine-run.mjs apt",
    "engine:build:latest": "node scripts/engine-run.mjs net"
  },
  "dependencies": {
    "@drgrice1/dvi2html": "0.0.7-beta4",
    "buffer": "6.0.3",
    "idb": "8.0.4",
    "pako": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "21.0.1",
    "obsidian": "1.14.4",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "tsgo": "npm:typescript@7.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian",
      "@eslint/js": "$@eslint/js"
    }
  }
}
