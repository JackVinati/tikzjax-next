{
  "name": "tikzjax-next",
  "version": "0.1.3",
  "description": "Render TikZ and LaTeX diagrams in your notes",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "//": [
    "Two TypeScripts, deliberately. See internal/DECISIONS.md D5.",
    "  typescript 5.9.3  exists ONLY to satisfy typescript-eslint, whose peer range caps at <6.1.0",
    "                    and which imports the classic compiler API that TypeScript 7 replaced with",
    "                    ./unstable/*. It never typechecks this project.",
    "  tsgo              is the real typechecker: an alias for typescript@7.0.2, the native Go",
    "                    compiler. Aliased so it does not collide with the above; `npm run",
    "                    typecheck` invokes it by path because both packages ship a `tsc` bin.",
    "When typescript-eslint supports TS 7: delete the alias, bump typescript, drop typecheck:legacy."
  ],
  "scripts": {
    "dev": "node scripts/esbuild.config.mjs",
    "build": "npm run typecheck && node scripts/esbuild.config.mjs production",
    "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "oxlint src scripts engine-src test --ignore-pattern \"engine-src/upstream/**\"",
    "lint:store": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "RUN_GOLDEN=1 vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify:fork": "node scripts/verify-fork.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "scan:native": "node scripts/scan-native-unicode.mjs",
    "engine:image": "docker build -t tikzjax-engine:apt --build-arg TEXLIVE=apt engine-build",
    "engine:image:latest": "docker build -t tikzjax-engine:net --build-arg TEXLIVE=net engine-build",
    "engine:build": "node scripts/engine-run.mjs apt",
    "engine:build:latest": "node scripts/engine-run.mjs net"
  },
  "dependencies": {
    "@drgrice1/dvi2html": "0.0.7-beta4",
    "buffer": "^6.0.3",
    "idb": "8.0.4",
    "pako": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "21.0.1",
    "obsidian": "1.14.4",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "svgo": "4.1.0",
    "tsgo": "npm:typescript@7.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian",
      "@eslint/js": "$@eslint/js"
    }
  }
}
